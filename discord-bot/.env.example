# Summit Discord Bot & Web App - Shared Environment Variables
# Copy this file to .env and fill in your actual values
# Both the Discord bot and web app read from this file

# ============================================================================
# Discord Bot Configuration
# ============================================================================

# Discord Bot Token (required for bot)
# Get from: https://discord.com/developers/applications
TOKEN=your_discord_bot_token_here

# ============================================================================
# Web App Configuration (Optional - only needed if running web app)
# ============================================================================

# Discord OAuth for web app login (optional)
# Get from: https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback

# Flask Secret Key (optional in dev, required in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Google OAuth (optional - if you want Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# API Keys for external integrations (optional, comma-separated)
API_KEYS=key1,key2,key3

# Admin Discord/Google IDs for web app (comma-separated)
ADMIN_IDS=123456789012345678,987654321098765432
# Curio editor IDs - can add/edit/delete curio entries (comma-separated)
CURIO_EDITOR_IDS=123456789012345678

# ============================================================================
# Discord Bot IDs (required for bot)
# ============================================================================

# Channel IDs
FART_CHANNEL_ID=0
LFG_CHANNEL_ID=0
WELCOME_CHANNEL_ID=0
MILESTONE_CHANNEL_ID=0
LEADERBOARD_CHANNEL_ID=0
DM_DISABLED_CHANNEL_ID=0
DECKLISTS_CHANNEL_ID=0

# User/Role IDs
OWNER_ID=0
GUILD_ID=0
LEADER_ROLE_ID=0
DM_DISABLED_ROLE_ID=0
MASTERS_ROLE_IDS=0,0
TICKET_HOLDER_ROLE_IDS=0
MAGE_ROLE_ID=0
BOT_ADMIN_ROLE_ID=0
JUDGE_ROLE_ID=0
ACTIVE_PLAYER_ROLE_ID=0

# ============================================================================
# Database Path Overrides (Optional - advanced usage only)
# ============================================================================

# Override default database locations (defaults to discord-bot/*.db)
# ELO_DB_PATH=path/to/elo.db
# MATCH_RECORDS_DB_PATH=path/to/match_records.db
# FART_SCORES_DB_PATH=path/to/fart_scores.db
# COMMUNITY_DB_PATH=path/to/community.db

# ============================================================================
# Store (real-money token card sales)
# ============================================================================

# Discord IDs allowed into the store admin section (comma-separated).
# Deliberately separate from ADMIN_IDS - global admins do NOT get store access.
# STORE_ADMIN_IDS=123456789012345678

# Optional override; defaults to web-app/store.db
# STORE_DB_PATH=path/to/store.db
