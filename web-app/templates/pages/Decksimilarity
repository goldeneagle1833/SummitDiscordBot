<template>
  <div class="deck-jaccard-stats">
    <h3 class="stats-title">Deck Similarity</h3>

    <div v-if="loading" class="stats-loading">
      <div class="loading-spinner"></div>
      <p>Calculating Jaccard indices...</p>
    </div>
    <div v-else-if="error" class="stats-error">
      <span class="error-icon">⚠️</span>
      <p>{{ error }}</p>
    </div>
    <div v-else class="stats-content">
      <div class="tables-container">
        <!-- Jaccard Table -->
        <table class="stats-table">
          <thead>
            <tr>
              <th></th>
              <th>
                Distinct Cards
                <button
                  class="info-icon"
                  type="button"
                  tabindex="0"
                  aria-label="Jaccard index based on distinct card names: intersection ÷ union"
                  data-tip="Jaccard index based on distinct card names: intersection ÷ union">
                  ?
                </button>
              </th>
              <th>
                Total Cards
                <button
                  class="info-icon"
                  type="button"
                  tabindex="0"
                  aria-label="Jaccard index based on total card counts: intersection ÷ union"
                  data-tip="Jaccard index based on total card counts (quantities): intersection ÷ union">
                  ?
                </button>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Spells</strong></td>
              <td>{{ formatValue(stats.spells.unique) }}</td>
              <td>{{ formatValue(stats.spells.total) }}</td>
            </tr>
            <tr>
              <td><strong>Sites</strong></td>
              <td>{{ formatValue(stats.sites.unique) }}</td>
              <td>{{ formatValue(stats.sites.total) }}</td>
            </tr>
          </tbody>
        </table>

        <!-- Deck Composition Table -->
        <table class="stats-table">
          <thead>
            <tr>
              <th></th>
              <th>{{ displayDeckAName }}</th>
              <th>{{ displayDeckBName }}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Spells</strong></td>
              <td>{{ counts.spells.a }}</td>
              <td>{{ counts.spells.b }}</td>
            </tr>
            <tr>
              <td><strong>Sites</strong></td>
              <td>{{ counts.sites.a }}</td>
              <td>{{ counts.sites.b }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</template>

<script>
  export default {
    name: "DeckJaccardStats",
    props: {
      diff: {
        type: Object,
        required: true,
      },
      deckAName: {
        type: String,
        required: true,
      },
      deckBName: {
        type: String,
        required: true,
      },
    },
    data() {
      return {
        similarityMetric: "jaccard", //'jaccard', // or 'overlap'
        stats: {
          spells: { unique: 0, total: 0 },
          sites: { unique: 0, total: 0 },
        },
        counts: {
          spells: { a: 0, b: 0 },
          sites: { a: 0, b: 0 },
        },
        loading: false,
        error: null,
      };
    },
    computed: {
      displayDeckAName() {
        return this.deckAName || "Deck A";
      },
      displayDeckBName() {
        return this.deckBName || "Deck B";
      },
    },
    mounted() {
      this.calculateStats();
    },
    watch: {
      diff: {
        handler() {
          this.calculateStats();
        },
        deep: true,
      },
    },
    methods: {
      formatValue(value) {
        return value.toFixed(3);
      },

      computeJaccard(categoryFilter) {
        const uniqueA = new Set();
        const uniqueB = new Set();
        const allNames = new Set();

        let totalA = 0;
        let totalB = 0;
        const allCounts = {};

        for (const category in this.diff) {
          if (!categoryFilter(category)) continue;
          const categoryData = this.diff[category];

          if (categoryData.unique_a) {
            for (const card of categoryData.unique_a) {
              uniqueA.add(card.name);
              totalA += card.quantity || 1;
              if (!allCounts[card.name]) allCounts[card.name] = { a: 0, b: 0 };
              allCounts[card.name].a += card.quantity || 1;
            }
          }

          if (categoryData.shared) {
            for (const card of categoryData.shared) {
              uniqueA.add(card.name);
              uniqueB.add(card.name);
              totalA += card.quantity_a || 1;
              totalB += card.quantity_b || 1;
              if (!allCounts[card.name]) allCounts[card.name] = { a: 0, b: 0 };
              allCounts[card.name].a += card.quantity_a || 1;
              allCounts[card.name].b += card.quantity_b || 1;
            }
          }

          if (categoryData.unique_b) {
            for (const card of categoryData.unique_b) {
              uniqueB.add(card.name);
              totalB += card.quantity || 1;
              if (!allCounts[card.name]) allCounts[card.name] = { a: 0, b: 0 };
              allCounts[card.name].b += card.quantity || 1;
            }
          }
        }

        for (const name of uniqueA) allNames.add(name);
        for (const name of uniqueB) allNames.add(name);
        const intersectionUnique = [...uniqueA].filter((x) =>
          uniqueB.has(x),
        ).length;
        const jUnique =
          allNames.size > 0 ? intersectionUnique / allNames.size : 0;

        let intersectionTotal = 0;
        for (const name in allCounts) {
          intersectionTotal += Math.min(allCounts[name].a, allCounts[name].b);
        }
        const unionTotal = totalA + totalB - intersectionTotal;
        const jTotal = unionTotal > 0 ? intersectionTotal / unionTotal : 0;

        return { unique: jUnique, total: jTotal };
      },

      computeOverlap(categoryFilter) {
        const uniqueA = new Set();
        const uniqueB = new Set();

        let totalA = 0;
        let totalB = 0;
        const allCounts = {};

        for (const category in this.diff) {
          if (!categoryFilter(category)) continue;
          const categoryData = this.diff[category];

          if (categoryData.unique_a) {
            for (const card of categoryData.unique_a) {
              uniqueA.add(card.name);
              totalA += card.quantity || 1;
              if (!allCounts[card.name]) allCounts[card.name] = { a: 0, b: 0 };
              allCounts[card.name].a += card.quantity || 1;
            }
          }

          if (categoryData.shared) {
            for (const card of categoryData.shared) {
              uniqueA.add(card.name);
              uniqueB.add(card.name);
              totalA += card.quantity_a || 1;
              totalB += card.quantity_b || 1;
              if (!allCounts[card.name]) allCounts[card.name] = { a: 0, b: 0 };
              allCounts[card.name].a += card.quantity_a || 1;
              allCounts[card.name].b += card.quantity_b || 1;
            }
          }

          if (categoryData.unique_b) {
            for (const card of categoryData.unique_b) {
              uniqueB.add(card.name);
              totalB += card.quantity || 1;
              if (!allCounts[card.name]) allCounts[card.name] = { a: 0, b: 0 };
              allCounts[card.name].b += card.quantity || 1;
            }
          }
        }

        // uniques
        const intersectionUnique = [...uniqueA].filter((x) =>
          uniqueB.has(x),
        ).length;
        const minUnique = Math.min(uniqueA.size, uniqueB.size);
        const oUnique = minUnique > 0 ? intersectionUnique / minUnique : 0;

        // totals
        let intersectionTotal = 0;
        for (const name in allCounts) {
          intersectionTotal += Math.min(allCounts[name].a, allCounts[name].b);
        }
        const minTotal = Math.min(totalA, totalB);
        const oTotal = minTotal > 0 ? intersectionTotal / minTotal : 0;

        return { unique: oUnique, total: oTotal };
      },

      computeCounts(categoryFilter) {
        let countA = 0,
          countB = 0;
        for (const category in this.diff) {
          if (!categoryFilter(category)) continue;
          const categoryData = this.diff[category];
          if (categoryData.unique_a) {
            countA += categoryData.unique_a.reduce(
              (sum, c) => sum + (c.quantity || 1),
              0,
            );
          }
          if (categoryData.unique_b) {
            countB += categoryData.unique_b.reduce(
              (sum, c) => sum + (c.quantity || 1),
              0,
            );
          }
          if (categoryData.shared) {
            countA += categoryData.shared.reduce(
              (sum, c) => sum + (c.quantity_a || 1),
              0,
            );
            countB += categoryData.shared.reduce(
              (sum, c) => sum + (c.quantity_b || 1),
              0,
            );
          }
        }
        return { a: countA, b: countB };
      },

      calculateStats() {
        if (!this.diff || Object.keys(this.diff).length === 0) return;

        this.loading = true;
        this.error = null;

        try {
          const fn =
            this.similarityMetric === "overlap"
              ? this.computeOverlap
              : this.computeJaccard;

          this.stats.spells = fn((category) => category !== "Site");
          this.stats.sites = fn((category) => category === "Site");
          this.counts.spells = this.computeCounts(
            (category) => category !== "Site",
          );
          this.counts.sites = this.computeCounts(
            (category) => category === "Site",
          );

          this.loading = false;
        } catch (err) {
          this.error = "Failed to calculate deck similarity";
          this.loading = false;
        }
      },
    },
  };
</script>

