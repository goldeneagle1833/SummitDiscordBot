[Unit]
Description=Summit Discord Bot Web Application
Documentation=https://github.com/your-repo/SummitDiscordBot
After=network.target

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/root/Summit/SummitDiscordBot/web-app

# Load environment variables from the shared .env file
EnvironmentFile=/root/Summit/SummitDiscordBot/discord-bot/.env

# Fewer malloc arenas: the cache-building background threads otherwise each
# get their own arena, which fragments and keeps worker RSS high.
Environment="MALLOC_ARENA_MAX=2"

# Set PATH to ensure gunicorn is found
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Start gunicorn with the configuration file
ExecStart=/root/Summit/SummitDiscordBot/web-app/venv/bin/gunicorn --config gunicorn_config.py app:app

# Restart policy
Restart=always
RestartSec=10

# Process limits and resource management
LimitNOFILE=4096
TimeoutStopSec=30

# Security settings (optional - uncomment for additional hardening)
# NoNewPrivileges=true
# PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=summit-web

[Install]
WantedBy=multi-user.target
